# ====================================================================
# STAGING (Node.js + whatsapp-web.js) — copy ke .env, JANGAN commit .env
# Beda dengan produksi Go (Mac Mini): mesin terpisah, DB terpisah,
# tunnel terpisah, NOMOR SENDER terpisah, Sheet terpisah.
# ====================================================================

# --- Server ---
# Port HTTP (default 8080). Pakai port beda kalau di mesin yang sama ada app lain.
PORT=8080

# --- Google OAuth ---
# Boleh pakai OAuth client yang SAMA dgn produksi, asal redirect URI staging
# DITAMBAHKAN ke "Authorized redirect URIs" di GCP.
GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxx

# Callback aktif untuk staging. Harus persis match URI di GCP.
# Lokal dev: http://localhost:8080/auth/callback
# Staging (tunnel): https://<tunnel-staging>/auth/callback
OAUTH_REDIRECT_URL=http://localhost:8080/auth/callback

# --- Session ---
# HMAC-SHA256 signing key cookie. Generate baru utk staging: openssl rand -hex 32
SESSION_SECRET=ganti-dengan-string-random-64-char-hex

# --- Same-origin (lihat README) ---
# Kosongkan FRONTEND_URL → redirect pasca-login ke "/" (same-origin, jalan semua browser).
FRONTEND_URL=
# CORS allowed origins (koma). Same-origin tidak butuh ini; isi hanya kalau frontend beda host.
ALLOWED_ORIGINS=http://localhost:8080

# --- Google Sheets export (OPSIONAL tapi disarankan terpisah dari produksi) ---
GOOGLE_SERVICE_ACCOUNT_JSON=service-account.json
# PENTING: pakai SPREADSHEET STAGING TERPISAH supaya tidak menimpa data produksi.
GSHEET_SPREADSHEET_ID=
GSHEET_SHEET_NAME=Blast Log
GSHEET_REPORT_SHEET_NAME=Belum Respons
GSHEET_QUERY_SHEET_NAME=Query Blast

# --- Template blast (OPSIONAL — default sudah sesuai spec majoo) ---
# Pakai \n untuk newline. Variabel: {{nama_outlet}}, {{nomer_invoice}}
# TEMPLATE_ATTEMPT_1=Halo, Majoopreneurs!\n\n...
# TEMPLATE_ATTEMPT_2=...
# TEMPLATE_ATTEMPT_3=...
# INBOX_CLOSING_TEMPLATE=Baik, terima kasih...\n... {{nama_outlet}} ...

# --- Scheduler retry ---
# Tiap hari saat masuk jam RETRY_WINDOW_HOUR (WIB), proses antrian "Belum Respons"
# (after_blast + in_progress), kirim attempt berikutnya. Maks 1x/hari per nomor.
RETRY_WINDOW_HOUR=9
RETRY_CHECK_INTERVAL_MINUTES=30
RETRY_SEND_MIN_DELAY=20
RETRY_SEND_MAX_DELAY=40
# DEFAULT AMAN DI STAGING: auto-cron MATI (cegah burst → ban). Pakai tombol manual
# "Run Blast Attempt" / POST /api/retry/run-now untuk uji terkontrol.
RETRY_ENABLED=false

# --- whatsapp-web.js ---
# Folder sesi LocalAuth (folder browser). JANGAN commit. Hapus folder ini = logout.
WWEBJS_DATA_PATH=.wwebjs_auth
# Opsional: pakai Chrome/Chromium sistem (kalau tidak, puppeteer unduh Chromium sendiri).
# macOS contoh: /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# Linux contoh: /usr/bin/chromium-browser
# PUPPETEER_EXECUTABLE_PATH=
