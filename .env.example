# ====================================================================
# Backend config — file ini WAJIB di-copy ke .env (jangan commit .env)
# ====================================================================

# --- Google OAuth ---
# Buat di https://console.cloud.google.com/apis/credentials
# Authorized redirect URIs di GCP harus persis match OAUTH_REDIRECT_URL.
# Untuk lokal dev tambahkan: http://localhost:8080/auth/callback
# Untuk produksi tambahkan: https://blast-wa-api.majoo.id/auth/callback
GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxx

# URL callback aktif untuk environment ini (cuma satu yang dipakai).
# Lokal: http://localhost:8080/auth/callback
# Produksi: https://blast-wa-api.majoo.id/auth/callback
OAUTH_REDIRECT_URL=https://blast-wa-api.majoo.id/auth/callback

# --- Session ---
# HMAC-SHA256 signing key untuk session cookie. JANGAN ROTATE di produksi.
# Generate: openssl rand -hex 32
SESSION_SECRET=ganti-dengan-string-random-64-char-hex

# --- Cross-site (GitHub Pages → backend) ---
# URL frontend di GitHub Pages. Setelah OAuth sukses, user di-redirect ke sini.
# Contoh: https://username.github.io/blast-wa-personal
FRONTEND_URL=https://USERNAME.github.io/blast-wa-personal

# CORS allowed origins, dipisah koma. Harus mencakup FRONTEND_URL (tanpa trailing slash).
# Boleh tambah origin dev: http://localhost:5500 (live-server) atau http://127.0.0.1:5500
ALLOWED_ORIGINS=https://USERNAME.github.io,http://localhost:5500

# --- Google Sheets export (OPSIONAL) ---
# Path ke service account JSON file (download dari GCP IAM & Admin → Service Accounts → Keys)
# Jangan commit file ini ke git!
# Contoh: GOOGLE_SERVICE_ACCOUNT_JSON=service-account.json
GOOGLE_SERVICE_ACCOUNT_JSON=

# Spreadsheet ID — ambil dari URL Google Sheet:
# https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit
GSHEET_SPREADSHEET_ID=

# Nama sheet/tab dalam spreadsheet (default: "Blast Log")
GSHEET_SHEET_NAME=Blast Log

# --- 3 Template Blast (OPSIONAL — override default sesuai spec majoo) ---
# Setiap blast pakai attempt 1. Cron auto-kirim attempt 2 (24h kalau no reply),
# lalu attempt 3 (24h lagi kalau no reply). User reply → stop retry.
# Pakai \n untuk newline. Variabel: {{nama_outlet}}, {{nomer_invoice}}
# TEMPLATE_ATTEMPT_1=Halo, Majoopreneurs!\n\nTerima kasih...
# TEMPLATE_ATTEMPT_2=Halo, Majoopreneurs!\n\nMohon maaf, ingin konfirmasi kembali...
# TEMPLATE_ATTEMPT_3=Halo, Majoopreneurs!\n\nIzin follow up kembali...

# Tuning scheduler retry (opsional)
# Flow: tiap hari saat masuk jam RETRY_WINDOW_HOUR (WIB), cron memproses antrian
# "Belum Respons" (status after_blast + in_progress) dan kirim attempt berikutnya.
# Maks 1 attempt/hari per nomor. User balas (status → open) otomatis keluar antrian.
# RETRY_WINDOW_HOUR=9               # jam (0-23, WIB) mulai blast attempt 2/3
# RETRY_FORCECLOSE_HOUR=17          # jam (0-23, WIB) force-close-sweep: Attempt 3 tanpa respons s/d jam ini → bucket 'force_close' (After Blast + In Progress)
# RETRY_CHECK_INTERVAL_MINUTES=30   # cek tiap berapa menit (harus < 60 agar window jam pasti kena)
# RETRY_SEND_MIN_DELAY=20           # jitter antar send (detik, min)
# RETRY_SEND_MAX_DELAY=40           # jitter antar send (detik, max)

# --- Inbox Chat closing template (OPSIONAL) ---
# Template pesan saat klik tombol "Done/Resolved" di inbox.
# Boleh pakai \n untuk newline, dan {{nama_outlet}} sebagai placeholder.
# Default: pesan terima kasih standar.
# INBOX_CLOSING_TEMPLATE=Halo {{nama_outlet}},\n\nTerima kasih atas konfirmasinya. Tiket selesai.\n\n— Tim majoo

# --- Server ---
# Port server (opsional, default :8080)
# ADDR=:8080

